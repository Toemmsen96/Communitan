# Copy to .env (or run ../tools/server-init.sh, which fills in random values).
# NEVER commit .env. Changing secrets later logs everybody out (fine).
POSTGRES_PASSWORD=change-me
SESSION_ENCRYPTION_KEY=change-me
SESSION_REFRESH_ENCRYPTION_KEY=change-me
CONSOLE_USERNAME=admin
CONSOLE_PASSWORD=change-me
CONSOLE_SIGNING_KEY=change-me
# Client "server key": public by design (players type it in the mod's Advanced field,
# it is sent with every request). Not a secret, but change it per server and tell your players.
NAKAMA_SERVER_KEY=defaultkey
LOG_LEVEL=INFO
# Public status key (NOT a secret): the mod's server list reads player counts with it before login (RPC COMMUNITAN_STATUS).
# Every other RPC refuses calls without a session. Keep the default so the mod finds it.
# NAKAMA_HTTP_KEY=catan-public-status
# --- Email verification for new email accounts (no mail is ever sent) ---
# ingame (default): the game shows a 6-digit activation code to the player; off: accounts are verified immediately.
# CATAN_EMAIL_VERIFICATION=ingame
# --- Server-side randomness (anti-cheat, docs/design/server-rng.md) ---
# off (default): the creator's client picks seeds (vanilla); seeds: the server picks board/dice/color seeds per game;
# full: seeds + server dice and server-decided steals/cards (every player needs a current mod).
# CATAN_SERVER_RNG=off
# --- Paid content (docs/HOSTING.md "Entitlements"; README "Operator responsibility and liability") ---
# free (default): every player gets what a free official account has; owned: plus the player's own official
# purchases, mirrored by the mod. Nothing is ever sold.
# CATAN_ENTITLEMENTS=free
# --- HTTPS (docker compose --profile https up -d) ---
# DOMAIN=catan.example.org
# NAKAMA_BIND=127.0.0.1
