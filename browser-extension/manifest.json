{
  "manifest_version": 3,
  "name": "Communitan",
  "short_name": "Communitan",
  "version": "0.1.0",
  "description": "Play the Catan Universe browser game on community servers (unofficial fan project).",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Communitan server",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "background": {
    "script": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "analytics",
        "enabled": false,
        "path": "rules/analytics.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://catanuniverse.com/game/*",
        "https://catanuniverse.com/*/game/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://catanuniverse.com/game/*",
        "https://catanuniverse.com/*/game/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "communitan@toemmsen96",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
